# Database
DATABASE_URL="postgresql://uamsatech:uamsatech@localhost:5432/uamsatech_db"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth — required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=""

# Email (optional) — verification/reset emails log to the console if unset.
RESEND_API_KEY=""
EMAIL_FROM="UAMSATech <noreply@uamsatech.com>"

# Cookie domain (optional) — set to ".uamsatech.com" in production so the
# access/refresh cookies are shared across every product subdomain (SSO).
COOKIE_DOMAIN=""

# Billing (all optional) — checkout/webhook routes return a clear
# "not configured" error for any provider whose keys are unset, rather than
# the app failing to boot.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Admin (optional) — comma-separated emails allowed into /admin. Leave unset
# and nobody can reach the internal analytics/revenue dashboards.
ADMIN_EMAILS=""

# Analytics (all optional, public) — Google Analytics and Microsoft Clarity
# scripts simply don't load if their ID is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Metrics (optional) — if set, GET /api/metrics requires this as a Bearer
# token. Leave unset if /metrics is already restricted at the network/proxy
# level (see deploy/nginx/uamsatech.conf).
METRICS_TOKEN=""

# Redis (optional) — rate limiting uses it when set, falls back to an
# in-memory limiter when unset. Needed for correct rate limiting once you're
# running more than one app instance.
REDIS_URL=""

# Object storage (optional, all five must be set together) — S3-compatible,
# works with real AWS S3 or any S3-compatible endpoint (Cloudflare R2, MinIO,
# Cloudinary's S3 gateway) via S3_ENDPOINT. Currently used for portal profile
# avatar uploads only; the upload button is disabled until this is set.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""
