generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  name                      String?
  avatarUrl                 String?
  passwordHash              String?
  emailVerified             DateTime?
  emailNotificationsEnabled Boolean              @default(true)
  memberships               Membership[]
  invitationsSent           Invitation[]
  refreshTokens             RefreshToken[]
  verificationTokens        VerificationToken[]
  apiKeys                   ApiKey[]
  supportTickets            SupportTicket[]
  ticketMessages            TicketMessage[]
  bugReports                BugReport[]
  featureRequests           FeatureRequest[]
  featureRequestVotes       FeatureRequestVote[]
  auditLogs                 AuditLog[]
  comments                  Comment[]
  analyticsEvents           AnalyticsEvent[]
  subscriptions             Subscription[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  linksRequested   OrganizationInstitutionLink[] @relation("LinkRequestedBy")
  linksVerified    OrganizationInstitutionLink[] @relation("LinkVerifiedBy")
  linksRevoked     OrganizationInstitutionLink[] @relation("LinkRevokedBy")
  licencesIssued   InstitutionLicence[]          @relation("LicenceIssuedBy")
  seats            LicenceSeat[]                 @relation("SeatHolder")
  seatsAssigned    LicenceSeat[]                 @relation("SeatAssignedBy")
  seatsReleased    LicenceSeat[]                 @relation("SeatReleasedBy")
  trials           TrialGrant[]                  @relation("TrialUser")
  trialsAuthorized TrialGrant[]                  @relation("TrialAuthorizedBy")
  trialsRevoked    TrialGrant[]                  @relation("TrialRevokedBy")
  operatorGrants   OperatorGrant[]               @relation("OperatorGrantee")
  operatorIssued   OperatorGrant[]               @relation("OperatorIssuedBy")
  operatorApproved OperatorGrant[]               @relation("OperatorApprovedBy")
  operatorRevoked  OperatorGrant[]               @relation("OperatorRevokedBy")

  @@map("users")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  memberships     Membership[]
  invitations     Invitation[]
  subscriptions   Subscription[]
  refreshTokens   RefreshToken[]
  apiKeys         ApiKey[]
  usageRecords    UsageRecord[]
  auditLogs       AuditLog[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institutionLinks OrganizationInstitutionLink[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole     @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Invitation {
  id              String       @id @default(cuid())
  email           String
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            UserRole     @default(MEMBER)
  tokenHash       String       @unique
  invitedByUserId String
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@unique([email, organizationId])
  @@map("invitations")
}

model RefreshToken {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tokenHash      String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@map("verification_tokens")
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  productPlans  ProductPlan[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  entitlementPeriods EntitlementPeriod[]
  institutionLinks   OrganizationInstitutionLink[]
  licences           InstitutionLicence[]
  trialGrants        TrialGrant[]
  operatorGrants     OperatorGrant[]

  @@map("products")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum BillingProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

// A platform-wide tier definition (Free / Starter / Professional /
// Enterprise). Deliberately has no price or product of its own — the same
// four tiers apply across every product, each priced independently via
// ProductPlan. Mirrors how Stripe itself separates Product from Price.
model Plan {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  description  String?
  sortOrder    Int           @default(0)
  productPlans ProductPlan[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("plans")
}

// The concrete, purchasable offering: this Plan tier, for this Product, at
// this price. Not every product has every tier (e.g. UAMSA has none — it's
// quotation-only; Records has no Free tier).
model ProductPlan {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  planId            String
  plan              Plan           @relation(fields: [planId], references: [id])
  interval          PlanInterval
  priceCents        Int
  currency          String         @default("USD")
  isStartingPrice   Boolean        @default(false)
  stripePriceId     String?
  paystackPlanCode  String?
  flutterwavePlanId String?
  features          String[]
  isActive          Boolean        @default(true)
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  invoices Invoice[]
  licences InstitutionLicence[]

  @@unique([productId, planId])
  @@map("product_plans")
}

// Either organizationId or userId is set, never both, never neither — a
// database CHECK constraint enforces this (see the migration SQL), since an
// individual subscriber has no Organization to attach to. Individual plans
// only exist for products whose `pricingPlans` includes "individual"
// (lib/site-config.ts) — enforced in lib/billing/checkout-context.ts.
model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String?
  organization           Organization?      @relation(fields: [organizationId], references: [id])
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id])
  productId              String
  product                Product            @relation(fields: [productId], references: [id])
  productPlanId          String?
  productPlan            ProductPlan?       @relation(fields: [productPlanId], references: [id])
  couponId               String?
  coupon                 Coupon?            @relation(fields: [couponId], references: [id])
  status                 SubscriptionStatus @default(ACTIVE)
  provider               BillingProvider?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  invoices               Invoice[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  periods  EntitlementPeriod[]
  licences InstitutionLicence[]

  @@unique([organizationId, productId])
  @@unique([userId, productId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id                String          @id @default(cuid())
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  organizationId    String?
  userId            String?
  amountCents       Int
  currency          String          @default("NGN")
  status            InvoiceStatus   @default(OPEN)
  provider          BillingProvider
  providerInvoiceId String?
  hostedInvoiceUrl  String?
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  // AS-P0-SECURITY-007: purchase-time plan snapshot + ledger relations
  productPlanId      String?
  productPlan        ProductPlan?        @relation(fields: [productPlanId], references: [id], onDelete: SetNull)
  planInterval       PlanInterval?
  priceCentsSnapshot Int?
  couponIdSnapshot   String?
  verifiedAt         DateTime?
  periods            EntitlementPeriod[]
  refunds            PaymentRefund[]
  disputes           PaymentDispute[]
  providerEvents     ProviderEvent[]

  @@unique([provider, providerInvoiceId])
  @@map("invoices")
}

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id               String         @id @default(cuid())
  code             String         @unique
  discountType     DiscountType
  discountValue    Int
  currency         String?
  maxRedemptions   Int?
  timesRedeemed    Int            @default(0)
  validFrom        DateTime       @default(now())
  validUntil       DateTime?
  stripeCouponId   String?
  paystackCouponId String?
  isActive         Boolean        @default(true)
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())

  @@map("coupons")
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  metric         String
  quantity       Int
  recordedAt     DateTime     @default(now())

  @@map("usage_records")
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     Json
  publishedAt DateTime?
  authorId    String?
  author      Author?   @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  tags        Tag[]     @relation("BlogPostTags")
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model Author {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  title     String?
  bio       String?
  initials  String
  posts     BlogPost[]
  createdAt DateTime   @default(now())

  @@map("authors")
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model Tag {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  posts BlogPost[] @relation("BlogPostTags")

  @@map("tags")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("comments")
}

// Knowledge base article. Repurposed from the unused Phase 1 `Documentation`
// model (never wired to any route) rather than adding a second, overlapping
// content table alongside it.
model KnowledgeBaseArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  excerpt     String?
  content     Json
  productSlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("knowledge_base_articles")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(cuid())
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("support_tickets")
}

enum TicketMessageAuthor {
  USER
  STAFF
}

// The "live chat" feature: an async message thread on a ticket, not a
// real-time widget. There is no platform-staff concept anywhere in this
// codebase (see Category/blog decision in docs/10-blog-cms.md) so STAFF
// messages are authored directly via script, the same way blog/docs content
// is managed — not through a live agent UI.
model TicketMessage {
  id        String              @id @default(cuid())
  ticketId  String
  ticket    SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    TicketMessageAuthor
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime            @default(now())

  @@map("ticket_messages")
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugReportStatus {
  OPEN
  CONFIRMED
  FIXED
  WONT_FIX
}

model BugReport {
  id               String          @id @default(cuid())
  title            String
  description      String
  stepsToReproduce String?
  severity         BugSeverity     @default(MEDIUM)
  productSlug      String?
  status           BugReportStatus @default(OPEN)
  userId           String?
  user             User?           @relation(fields: [userId], references: [id])
  email            String?
  createdAt        DateTime        @default(now())

  @@map("bug_reports")
}

enum FeatureRequestStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  SHIPPED
  CLOSED
}

model FeatureRequest {
  id          String               @id @default(cuid())
  title       String
  description String
  status      FeatureRequestStatus @default(OPEN)
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  votes       FeatureRequestVote[]
  createdAt   DateTime             @default(now())

  @@map("feature_requests")
}

model FeatureRequestVote {
  id               String         @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([featureRequestId, userId])
  @@map("feature_request_votes")
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

model Incident {
  id         String           @id @default(cuid())
  title      String
  body       String
  status     IncidentStatus   @default(INVESTIGATING)
  severity   IncidentSeverity @default(MINOR)
  service    String
  startedAt  DateTime         @default(now())
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("incidents")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  institution String?
  message     String
  createdAt   DateTime @default(now())

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id                   String    @id @default(cuid())
  email                String    @unique
  unsubscribeTokenHash String    @unique
  unsubscribedAt       DateTime?
  createdAt            DateTime  @default(now())

  @@map("newsletter_subscribers")
}

model ApiKey {
  id             String        @id @default(cuid())
  name           String
  keyPrefix      String
  keyHash        String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@map("api_keys")
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@map("audit_logs")
}

// First-party product/marketing event log — powers the admin Product
// Analytics and Conversion Tracking dashboards. Deliberately separate from
// AuditLog: that model is a security/compliance trail of account-affecting
// actions, this one is funnel/usage signal and carries no such guarantee.
model AnalyticsEvent {
  id             String        @id @default(cuid())
  name           String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([name, createdAt])
  @@map("analytics_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// AS-P0-SECURITY-007 — additive central billing & entitlement models.
// Migration: prisma/migrations/20261105090100_as_p0_007_central_billing_foundation
// (constraints Prisma cannot express live in that migration's SQL).
// ═══════════════════════════════════════════════════════════════════════════

enum EntitlementPeriodState {
  ACTIVE
  SUSPENDED
  REVOKED
  PENDING_REVIEW
}

enum RefundStatus {
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REVERSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
  UNKNOWN
}

enum ProviderEventVerification {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ProviderEventProcessing {
  RECEIVED
  PROCESSING
  APPLIED
  IGNORED
  DUPLICATE
  FAILED
}

enum InstitutionLinkStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum InstitutionLinkVerification {
  PRODUCT_OWNER_CHALLENGE
  OPERATOR_EVIDENCE
}

enum LicenceType {
  INSTITUTION_WIDE
  SEAT_BASED
}

enum LicenceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum SeatStatus {
  ACTIVE
  RELEASED
}

enum GrantStatus {
  ACTIVE
  REVOKED
}

enum TrialTarget {
  USER
  INSTITUTION
}

enum EntitlementSource {
  SUBSCRIPTION
  LICENCE
  TRIAL
  OPERATOR
}

enum EntitlementActorType {
  PROVIDER
  USER
  OPERATOR
  SYSTEM
}

/// Every provider webhook delivery (verified or not). Idempotency key is provider-scoped.
model ProviderEvent {
  id              String                    @id @default(cuid())
  provider        BillingProvider
  providerEventId String
  eventType       String
  verification    ProviderEventVerification @default(UNVERIFIED)
  processing      ProviderEventProcessing   @default(RECEIVED)
  attempts        Int                       @default(0)
  errorClass      String?
  payloadSha256   String
  facts           Json?
  invoiceId       String?
  invoice         Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refundId        String?
  refund          PaymentRefund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)
  disputeId       String?
  dispute         PaymentDispute?           @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  receivedAt      DateTime                  @default(now())
  verifiedAt      DateTime?
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([processing, receivedAt])
  @@map("provider_events")
}

/// Payment-to-entitlement ledger: the period one verified payment purchased for one subscription.
model EntitlementPeriod {
  id                    String                 @id @default(cuid())
  subscriptionId        String
  subscription          Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoiceId             String
  invoice               Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  paidAt                DateTime
  interval              PlanInterval?
  providerPeriodStart   DateTime?
  providerPeriodEnd     DateTime?
  periodStart           DateTime
  periodEnd             DateTime
  state                 EntitlementPeriodState @default(ACTIVE)
  stateReason           String?
  stateSourceRefundId   String?
  stateSourceDisputeId  String?
  productPlanIdSnapshot String?
  amountCents           Int
  currency              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  suspendingDisputes    PaymentDispute[]

  @@unique([invoiceId, subscriptionId])
  @@index([subscriptionId, paidAt, invoiceId])
  @@map("entitlement_periods")
}

model PaymentRefund {
  id                String          @id @default(cuid())
  provider          BillingProvider
  providerRefundId  String
  invoiceId         String
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents       Int
  currency          String
  status            RefundStatus    @default(REQUESTED)
  providerStatus    String?
  requestedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureClass      String?
  providerUpdatedAt DateTime
  verifiedAt        DateTime?
  history           Json            @default("[]")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  events            ProviderEvent[]

  @@unique([provider, providerRefundId])
  @@index([invoiceId, status])
  @@map("payment_refunds")
}

model PaymentDispute {
  id                  String             @id @default(cuid())
  provider            BillingProvider
  providerDisputeId   String
  invoiceId           String
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents         Int
  currency            String
  status              DisputeStatus      @default(OPEN)
  providerStatus      String
  openedAt            DateTime
  resolvedAt          DateTime?
  evidenceDueBy       DateTime?
  evidenceSubmittedAt DateTime?
  providerUpdatedAt   DateTime
  verifiedAt          DateTime
  suspendedPeriodId   String?
  suspendedPeriod     EntitlementPeriod? @relation(fields: [suspendedPeriodId], references: [id], onDelete: SetNull)
  history             Json               @default("[]")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  events              ProviderEvent[]

  @@unique([provider, providerDisputeId])
  @@index([invoiceId])
  @@map("payment_disputes")
}

/// Explicit, verified link between a portal organization and ONE product's institution.
model OrganizationInstitutionLink {
  id                   String                       @id @default(cuid())
  organizationId       String
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId            String
  product              Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productInstitutionId String
  status               InstitutionLinkStatus        @default(PENDING)
  verificationMethod   InstitutionLinkVerification?
  challengeSha256      String?
  challengeExpiresAt   DateTime?
  requestedById        String
  requestedBy          User                         @relation("LinkRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  verifiedById         String?
  verifiedBy           User?                        @relation("LinkVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt           DateTime?
  revokedAt            DateTime?
  revokedById          String?
  revokedBy            User?                        @relation("LinkRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason         String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  licences             InstitutionLicence[]
  trials               TrialGrant[]

  @@index([organizationId, productId])
  @@index([productId, productInstitutionId])
  @@map("organization_institution_links")
}

model InstitutionLicence {
  id                   String                      @id @default(cuid())
  linkId               String
  link                 OrganizationInstitutionLink @relation(fields: [linkId], references: [id], onDelete: Restrict)
  productId            String
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  licenceType          LicenceType
  status               LicenceStatus               @default(PENDING)
  startsAt             DateTime
  endsAt               DateTime
  productPlanId        String?
  productPlan          ProductPlan?                @relation(fields: [productPlanId], references: [id], onDelete: Restrict)
  seatCapacity         Int?
  sourceSubscriptionId String?
  sourceSubscription   Subscription?               @relation(fields: [sourceSubscriptionId], references: [id], onDelete: Restrict)
  issuedById           String
  issuedBy             User                        @relation("LicenceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  seats                LicenceSeat[]

  @@index([linkId, productId, status])
  @@map("institution_licences")
}

model LicenceSeat {
  id            String             @id @default(cuid())
  licenceId     String
  licence       InstitutionLicence @relation(fields: [licenceId], references: [id], onDelete: Restrict)
  userId        String
  user          User               @relation("SeatHolder", fields: [userId], references: [id], onDelete: Restrict)
  status        SeatStatus         @default(ACTIVE)
  assignedAt    DateTime           @default(now())
  assignedById  String
  assignedBy    User               @relation("SeatAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  releasedAt    DateTime?
  releasedById  String?
  releasedBy    User?              @relation("SeatReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  releaseReason String?

  @@index([licenceId, status])
  @@index([userId])
  @@map("licence_seats")
}

model TrialGrant {
  id             String                       @id @default(cuid())
  productId      String
  product        Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  targetType     TrialTarget
  userId         String?
  user           User?                        @relation("TrialUser", fields: [userId], references: [id], onDelete: Restrict)
  linkId         String?
  link           OrganizationInstitutionLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)
  status         GrantStatus                  @default(ACTIVE)
  startsAt       DateTime
  endsAt         DateTime
  reason         String
  authorizedById String
  authorizedBy   User                         @relation("TrialAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?                        @relation("TrialRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason   String?
  createdAt      DateTime                     @default(now())

  @@index([productId, userId])
  @@index([productId, linkId])
  @@map("trial_grants")
}

model OperatorGrant {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("OperatorGrantee", fields: [userId], references: [id], onDelete: Restrict)
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  status       GrantStatus @default(ACTIVE)
  reason       String
  issuedById   String
  issuedBy     User        @relation("OperatorIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  /// Two-person rule (mandatory): the approver differs from the grantee and the issuer (CHECK in SQL).
  approvedById String
  approvedBy   User        @relation("OperatorApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  startsAt     DateTime
  endsAt       DateTime
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?       @relation("OperatorRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason String?
  createdAt    DateTime    @default(now())

  @@index([userId, productId, status])
  @@map("operator_grants")
}

/// Append-only entitlement audit. No FKs, so history survives deletions; UPDATE/DELETE blocked by trigger.
model EntitlementChange {
  id                    String               @id @default(cuid())
  productId             String
  subjectUserId         String?
  subjectOrganizationId String?
  source                EntitlementSource
  sourceId              String
  action                String
  reason                String
  actorType             EntitlementActorType
  actorId               String?
  before                Json?
  after                 Json?
  providerEventId       String?
  correlationId         String?
  createdAt             DateTime             @default(now())

  @@index([productId, createdAt])
  @@index([source, sourceId])
  @@map("entitlement_changes")
}
