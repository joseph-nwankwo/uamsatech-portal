{
  "framework": "nextjs",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/internal/:path*",
      "destination": "/api/internal/:path*"
    }
  ]
}
